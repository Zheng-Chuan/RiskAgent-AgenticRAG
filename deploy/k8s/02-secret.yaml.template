# RiskAgent-AgenticRAG 敏感配置模板
# 使用方法: 复制为 02-secret.yaml 并填入真实值
# 注意: 02-secret.yaml 已在 .gitignore 中, 不会被提交
# 生产环境建议用 Sealed Secrets / External Secrets
apiVersion: v1
kind: Secret
metadata:
  name: riskagent-secret
  namespace: riskagent
  labels:
    app.kubernetes.io/name: riskagent-agenticrag
type: Opaque
stringData:
  # LLM API Key (硅基流动 SiliconFlow API)
  LLM_API_KEY: "<your-siliconflow-api-key>"
  LLM_BASE_URL: "https://api.siliconflow.cn/v1"
  LLM_MODEL: "deepseek-ai/DeepSeek-V3"

  # SiliconFlow API Key (用于 embedding 远程调用)
  OPENROUTER_API_KEY: "<your-siliconflow-api-key>"

  # Redis 密码
  REDIS_PASSWORD: "riskagent"
  REDIS_URL: "redis://:riskagent@redis.riskagent.svc.cluster.local:6379/0"

  # API Key (用于客户端认证)
  API_KEY_SECRET: "riskagent-k8s-api-key"

  # Milvus 认证 (standalone 默认无认证)
  MILVUS_USER: ""
  MILVUS_PASSWORD: ""
